# Clean Beans LLC website - Apache rules
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase must match BASE_PATH in app/config.php ("/w/" now, "/" after launch at the domain root)
  RewriteBase /w/

  # Private folders are never served directly
  RewriteRule ^(app|sql|err)(/|$) - [F,L]

  # Real files (CSS, JS, photos, install.php) are served as-is
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else goes to the front controller
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Never expose these file types even if one ends up in a public folder
<FilesMatch "\.(sql|log|lock|md|bak|ini|sh|yml)$|^config\.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>
